# Loopback only by default. A non-loopback host requires CEO_TOKEN.
HOST=127.0.0.1
PORT=3001
# CEO_TOKEN=replace-with-a-long-random-value
# DOCKER_BIN=C:\path\to\docker.exe
# CODEX_API_KEY=your-dedicated-openai-api-key
# Or explicitly provision a login with npm run agent:login:
# CODEX_AUTH_VOLUME=little-company-codex-auth
# AGENT_IMAGE=little-company-agent:local
# WEATHER_LAT=14.5995
# WEATHER_LON=120.9842
# Optional non-Windows vault key: base64 of 32 random bytes. Windows uses DPAPI by default.
# OFFICE_VAULT_KEY=
# Configure Outlook/Zoho client IDs in the app under Connected accounts, not in chat.
