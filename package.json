{
  "name": "little-company",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WORLD -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs",
    "format": "prettier --write src server shared tests scripts *.json *.ts *.js",
    "agent:image": "docker build -f Dockerfile.agent -t little-company-agent:local .",
    "agent:build": "npm run agent:image",
    "agent:login": "node --env-file-if-exists=.env scripts/agent-auth.mjs",
    "test:execution": "node --env-file-if-exists=.env --import tsx scripts/execution-smoke.ts",
    "test:workspace": "node --env-file-if-exists=.env --import tsx scripts/workspace-smoke.ts",
    "test:studio": "node --env-file-if-exists=.env --import tsx scripts/studio-smoke.ts",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "@tailwindcss/vite": "^4.1.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "playwright": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.181.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  }
}
